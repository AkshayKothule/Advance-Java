@model List<EndModule.Model.Product>

<html>
	<head>
		<title>Product Details</title>
	</head>
	<body>
		 <a href="/Home/Create">Add recoerd</a>
	<table border="1">
		<thead>
		<tr>
			<th>Id</th>
			<th>Name</th>
			<th>Description</th>
			<th>Price</th>
			<th>Qty</th>
									
			<th>Edit</th>
			<th>Deletd</th>
					
		</tr>
		</thead>
		<tbody>
		@foreach(var product in Model)
		{
			<tr>
				<td>@product.Id</td>
				<td>@product.Name</td>
				<td>@product.Description</td>
				<td>@product.Price</td>
				<td>@product.Qty</td>

				<td>
					<a href="/Home/Edit/@product.Id" >Edit</a>

				</td>

						
				<td>
					<a href="/Home/Delete/@product.Id" >Delete</a>

				</td>
			</tr>
		}
		</tbody>
	</table>
	
	<a href="/Login/SignOut">SignOut</a>

	</body>
</html>
